+/*
+ * Request API 를 쓰지 않는 사용자를 위해 버퍼 하나짜리 요청을 만들어
+ * 정규 경로에 태운다. 메타 노드는 기존 경로를 그대로 쓴다.
+ */
+static void mtk_cam_enqueue_no_request(struct mtk_cam_dev *cam,
+				       struct mtk_cam_video_device *node,
+				       struct mtk_cam_dev_buffer *buf)
+{
+	struct mtk_cam_dev_request *req;
+	unsigned long flags;
+
+	if (node->id != MTK_CAM_P1_MAIN_STREAM_OUT) {
+		mtk_isp_enqueue(cam, node->desc.dma_port, buf);
+		return;
+	}
+
+	req = kzalloc(sizeof(*req), GFP_KERNEL);
+	if (!req) {
+		vb2_buffer_done(&buf->vbb.vb2_buf, VB2_BUF_STATE_ERROR);
+		return;
+	}
+
+	req->synthetic = true;
+	req->sbuf = buf;
+	req->scam = cam;
+	req->frame_params.dma_bufs[buf->node_id].iova = buf->daddr;
+	req->frame_params.dma_bufs[buf->node_id].scp_addr = buf->scp_addr;
+
+	spin_lock_irqsave(&cam->pending_job_lock, flags);
+	list_add_tail(&req->list, &cam->pending_job_list);
+	spin_unlock_irqrestore(&cam->pending_job_lock, flags);
+
+	mtk_cam_dev_req_try_queue(cam);
+}
