+/*
+ * libcamera 의 simple 파이프라인 핸들러가 체인 전체에 포맷을 전파하려면
+ * 이 서브디바이스에도 pad 포맷 ops 가 있어야 한다. 하드웨어 설정은
+ * 스트림 온 시점에 센서 포맷으로부터 다시 계산하므로, 여기서는
+ * 요청 포맷을 pad 별로 저장/반환하기만 한다.
+ */
+static int mtk_cam_sd_init_state(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+	unsigned int i;
+
+	for (i = 0; i < sd->entity.num_pads; i++) {
+		fmt = v4l2_subdev_state_get_format(state, i);
+		if (!fmt)
+			continue;
+		fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+		fmt->width = 1600;
+		fmt->height = 1200;
+		fmt->field = V4L2_FIELD_NONE;
+		fmt->colorspace = V4L2_COLORSPACE_RAW;
+	}
+
+	return 0;
+}
+
+static int mtk_cam_sd_set_fmt(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state,
+			      struct v4l2_subdev_format *format)
+{
+	struct v4l2_mbus_framefmt *fmt;
+
+	fmt = v4l2_subdev_state_get_format(state, format->pad);
+	if (!fmt)
+		return -EINVAL;
+
+	format->format.field = V4L2_FIELD_NONE;
+	*fmt = format->format;
+
+	return 0;
+}
