+/*
+ * MTISP fourcc 는 'M', 패킹종류, 베이어순서(B/G/g/R), 비트수(8/A/C/E) 로
+ * 규칙적으로 구성된다. 여기서 대응하는 미디어 버스 코드를 도출한다.
+ * libcamera 처럼 mbus 코드로 포맷을 거르는 사용자에게 필요하다.
+ */
+static u32 mtk_cam_fmt_to_mbus(u32 fourcc)
+{
+	static const u32 codes[4][4] = {
+		/* 8bit, 10bit, 12bit, 14bit */
+		{ MEDIA_BUS_FMT_SBGGR8_1X8, MEDIA_BUS_FMT_SBGGR10_1X10,
+		  MEDIA_BUS_FMT_SBGGR12_1X12, MEDIA_BUS_FMT_SBGGR14_1X14 },
+		{ MEDIA_BUS_FMT_SGBRG8_1X8, MEDIA_BUS_FMT_SGBRG10_1X10,
+		  MEDIA_BUS_FMT_SGBRG12_1X12, MEDIA_BUS_FMT_SGBRG14_1X14 },
+		{ MEDIA_BUS_FMT_SGRBG8_1X8, MEDIA_BUS_FMT_SGRBG10_1X10,
+		  MEDIA_BUS_FMT_SGRBG12_1X12, MEDIA_BUS_FMT_SGRBG14_1X14 },
+		{ MEDIA_BUS_FMT_SRGGB8_1X8, MEDIA_BUS_FMT_SRGGB10_1X10,
+		  MEDIA_BUS_FMT_SRGGB12_1X12, MEDIA_BUS_FMT_SRGGB14_1X14 },
+	};
+	int order, depth;
+
+	/* 표준 베이어 fourcc 는 직접 대응시킨다 */
+	switch (fourcc) {
+	case V4L2_PIX_FMT_SBGGR8:
+		return MEDIA_BUS_FMT_SBGGR8_1X8;
+	case V4L2_PIX_FMT_SGBRG8:
+		return MEDIA_BUS_FMT_SGBRG8_1X8;
+	case V4L2_PIX_FMT_SGRBG8:
+		return MEDIA_BUS_FMT_SGRBG8_1X8;
+	case V4L2_PIX_FMT_SRGGB8:
+		return MEDIA_BUS_FMT_SRGGB8_1X8;
+	default:
+		break;
+	}
+
+	switch ((fourcc >> 16) & 0xff) {
+	case 'B': order = 0; break;
+	case 'G': order = 1; break;
+	case 'g': order = 2; break;
+	case 'R': order = 3; break;
+	default: return 0;
+	}
+
+	switch ((fourcc >> 24) & 0xff) {
+	case '8': depth = 0; break;
+	case 'A': depth = 1; break;
+	case 'C': depth = 2; break;
+	case 'E': depth = 3; break;
+	default: return 0;
+	}
+
+	return codes[order][depth];
+}
+
+/*
+ * ISP 는 입력 베이어를 8/10/12/14bit 로 잘라 쓸 수 있으므로,
+ * 포맷을 거를 때 비트수는 무시하고 베이어 순서만 비교한다.
+ */
+static int mtk_cam_bayer_order(u32 mbus_code)
+{
+	switch (mbus_code) {
+	case MEDIA_BUS_FMT_SBGGR8_1X8:
+	case MEDIA_BUS_FMT_SBGGR10_1X10:
+	case MEDIA_BUS_FMT_SBGGR12_1X12:
+	case MEDIA_BUS_FMT_SBGGR14_1X14:
+		return 0;
+	case MEDIA_BUS_FMT_SGBRG8_1X8:
+	case MEDIA_BUS_FMT_SGBRG10_1X10:
+	case MEDIA_BUS_FMT_SGBRG12_1X12:
+	case MEDIA_BUS_FMT_SGBRG14_1X14:
+		return 1;
+	case MEDIA_BUS_FMT_SGRBG8_1X8:
+	case MEDIA_BUS_FMT_SGRBG10_1X10:
+	case MEDIA_BUS_FMT_SGRBG12_1X12:
+	case MEDIA_BUS_FMT_SGRBG14_1X14:
+		return 2;
+	case MEDIA_BUS_FMT_SRGGB8_1X8:
+	case MEDIA_BUS_FMT_SRGGB10_1X10:
+	case MEDIA_BUS_FMT_SRGGB12_1X12:
+	case MEDIA_BUS_FMT_SRGGB14_1X14:
+		return 3;
+	default:
+		return -1;
+	}
+}
