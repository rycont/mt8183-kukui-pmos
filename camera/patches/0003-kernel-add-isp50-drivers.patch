diff -urN a/drivers/media/platform/mediatek/isp/Kconfig b/drivers/media/platform/mediatek/isp/Kconfig
--- a/drivers/media/platform/mediatek/isp/Kconfig	1970-01-01 09:00:00.000000000 +0900
+++ b/drivers/media/platform/mediatek/isp/Kconfig	2026-09-04 22:44:17.829533902 +0900
@@ -0,0 +1,35 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+config VIDEO_MEDIATEK_ISP_PASS1
+	tristate "MediaTek ISP Pass 1 driver"
+	depends on VIDEO_DEV
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on MTK_SCP
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select VIDEOBUF2_DMA_CONTIG
+	select V4L2_FWNODE
+	help
+	  Support for the MediaTek ISP Pass 1 hardware (camsys), which
+	  receives Bayer data from the sensor interface and writes it to
+	  memory together with 3A statistics.
+
+	  Demosaicing and colour processing are not performed by this
+	  block; use libcamera's software ISP or the DIP hardware.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk-cam-isp.
+
+config MTK_SENINF
+	tristate "MediaTek sensor interface (MIPI CSI-2 receiver)"
+	depends on VIDEO_DEV
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	help
+	  MIPI CSI-2 host driver for MediaTek SoCs. It connects camera
+	  sensors to the ISP and can handle several sensors at once.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mtk_seninf.
diff -urN a/drivers/media/platform/mediatek/isp/Makefile b/drivers/media/platform/mediatek/isp/Makefile
--- a/drivers/media/platform/mediatek/isp/Makefile	1970-01-01 09:00:00.000000000 +0900
+++ b/drivers/media/platform/mediatek/isp/Makefile	2026-09-04 22:44:17.830459693 +0900
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: GPL-2.0
+
+obj-$(CONFIG_VIDEO_MEDIATEK_ISP_PASS1) += isp_50/cam/
+obj-$(CONFIG_MTK_SENINF) += isp_50/seninf/
diff -urN a/drivers/media/platform/mediatek/isp/isp_50/cam/Makefile b/drivers/media/platform/mediatek/isp/isp_50/cam/Makefile
--- a/drivers/media/platform/mediatek/isp/isp_50/cam/Makefile	1970-01-01 09:00:00.000000000 +0900
+++ b/drivers/media/platform/mediatek/isp/isp_50/cam/Makefile	2026-09-04 22:44:17.831888324 +0900
@@ -0,0 +1,6 @@
+# SPDX-License-Identifier: GPL-2.0
