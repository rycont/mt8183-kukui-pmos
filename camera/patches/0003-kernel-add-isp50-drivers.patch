diff -urN a/drivers/media/platform/mediatek/isp/isp_50/cam/mtk_cam.c b/drivers/media/platform/mediatek/isp/isp_50/cam/mtk_cam.c
--- a/drivers/media/platform/mediatek/isp/isp_50/cam/mtk_cam.c	1970-01-01 09:00:00.000000000 +0900
+++ b/drivers/media/platform/mediatek/isp/isp_50/cam/mtk_cam.c	2026-09-05 01:24:42.000000000 +0900
@@ -0,0 +1,2476 @@
+// SPDX-License-Identifier: GPL-2.0
