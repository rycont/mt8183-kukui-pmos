diff -urN a/drivers/media/platform/mediatek/Makefile b/drivers/media/platform/mediatek/Makefile
--- a/drivers/media/platform/mediatek/Makefile	2026-09-04 22:48:38.944283817 +0900
+++ b/drivers/media/platform/mediatek/Makefile	2026-09-04 22:48:35.599144509 +0900
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0-only
