Subject: arm64: dts: mt8183-kukui: enable DPI output via IT6505 DP bridge

Kukui Chromebooks route the SoC DPI output to an ITE IT6505 DisplayPort
transmitter on i2c3, which drives the USB-C DP alt mode output. The
regulator for the bridge is already described, but the bridge itself and
the dpi0 output were never upstreamed, so external displays do not work.

Also wire the bridge as the HDMI codec so DP audio works.

--- a/arch/arm64/boot/dts/mediatek/mt8183-kukui.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt8183-kukui.dtsi
@@ -101,6 +101,7 @@
 
 	sound: mt8183-sound {
 		mediatek,platform = <&afe>;
+	mediatek,hdmi-codec = <&it6505dptx>;
 		pinctrl-names = "default",
 				"aud_tdm_out_on",
 				"aud_tdm_out_off";
@@ -250,6 +251,17 @@
 	proc-supply = <&mt6358_vproc11_reg>;
 };
 
+&dpi0 {
+	pinctrl-names = "sleep", "default";
+	pinctrl-0 = <&dpi_pin_default>;
+	pinctrl-1 = <&dpi_pin_func>;
+	status = "okay";
+};
+
+&dpi_out {
+	remote-endpoint = <&it6505_in>;
+};
+
 &dsi0 {
 	status = "okay";
 };
@@ -285,6 +297,37 @@
 	clock-frequency = <100000>;
 	#address-cells = <1>;
 	#size-cells = <0>;
+
+	it6505dptx: dp-bridge@5c {
+		compatible = "ite,it6505";
+		reg = <0x5c>;
+		interrupts-extended = <&pio 152 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&it6505_pins>;
+		#sound-dai-cells = <0>;
+		ovdd-supply = <&mt6358_vsim2_reg>;
+		pwr18-supply = <&it6505_pp18_reg>;
+		reset-gpios = <&pio 179 GPIO_ACTIVE_HIGH>;
+		extcon = <&usbc_extcon>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+
+				it6505_in: endpoint {
+					link-frequencies = /bits/ 64 <150000000>;
+					remote-endpoint = <&dpi_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+			};
+		};
+	};
 };
 
 &i2c5 {
@@ -506,6 +549,59 @@
