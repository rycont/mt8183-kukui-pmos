# Maintainer: 정한 Rycont <35295182+rycont@users.noreply.github.com>
pkgname=mali-vendor-krane
pkgver=0.1.0
pkgrel=0
pkgdesc="Run ARM's proprietary Mali userspace on mainline MT8183 (Mali-G72)"
url="https://github.com/rycont/mt8183-kukui-pmos/tree/main/gpu"
arch="aarch64"
license="MIT"
# The driver is loaded at startup rather than dlopened, because musl only grants
# initial-exec TLS to libraries present from the beginning; gcompat supplies the
# glibc symbols it asks for, and it wants a libc++ of its own.
depends="curl gcompat libarchive-tools libc++ mesa-gbm python3 vulkan-loader"
makedepends="vulkan-headers"
install="$pkgname.post-install"
source="
	tools/egl-gbm-shim.c
	tools/vk-present-sync-layer.c
	tools/cros-mali-shim.c
	tools/declare-dt-relr.py
	tools/mali-extract-root.py
	tools/mali-vendor-setup
	tools/mali-build-shims
	system/99-mali-dma-heap.rules
	system/plasma-mobile-mali.conf
	README.md
	"
builddir="$srcdir"
options="!check"

# abuild is not consistent about whether a local source keeps its directory,
# so look in both places rather than depend on it.
src() {
	if [ -e "$srcdir/$1" ]; then echo "$srcdir/$1"; else echo "$srcdir/${1##*/}"; fi
}

package() {
	# The sources are compiled on the device rather than here: the same files
	# have to be built once against musl and once against the glibc inside a
	# flatpak runtime, and only the device has both.
	install -Dm644 "$(src tools/egl-gbm-shim.c)" \
		"$pkgdir/usr/share/$pkgname/egl-gbm-shim.c"
	install -Dm644 "$(src tools/vk-present-sync-layer.c)" \
		"$pkgdir/usr/share/$pkgname/vk-present-sync-layer.c"
	install -Dm644 "$(src tools/cros-mali-shim.c)" \
		"$pkgdir/usr/share/$pkgname/cros-mali-shim.c"
	install -Dm644 "$(src README.md)" \
		"$pkgdir/usr/share/doc/$pkgname/README.md"

	install -Dm755 "$(src tools/mali-vendor-setup)" "$pkgdir/usr/bin/mali-vendor-setup"
	install -Dm755 "$(src tools/mali-build-shims)" "$pkgdir/usr/bin/mali-build-shims"
	install -Dm755 "$(src tools/declare-dt-relr.py)" "$pkgdir/usr/bin/mali-declare-dt-relr"
	install -Dm755 "$(src tools/mali-extract-root.py)" "$pkgdir/usr/bin/mali-extract-root"

	install -Dm644 "$(src system/99-mali-dma-heap.rules)" \
		"$pkgdir/usr/lib/udev/rules.d/99-mali-dma-heap.rules"
	install -Dm644 "$(src system/plasma-mobile-mali.conf)" \
		"$pkgdir/usr/lib/systemd/system/plasma-mobile.service.d/20-mali.conf"

	# The Vulkan layer manifests point at libraries mali-vendor-setup builds.
	for prefix in /opt/mali /opt/mali/glibc; do
		d="$pkgdir$prefix/share/vulkan/implicit_layer.d"
		install -d "$d"
		cat > "$d/VkLayer_mali_present_sync.json" <<-JSON
		{
		    "file_format_version": "1.1.2",
		    "layer": {
		        "name": "VK_LAYER_mali_present_sync",
		        "type": "GLOBAL",
		        "library_path": "$prefix/lib/libVkLayer_mali_present_sync.so",
		        "api_version": "1.3.313",
		        "implementation_version": "1",
		        "description": "Finish rendering before handing a frame to the compositor",
		        "disable_environment": { "MALI_PRESENT_SYNC_DISABLE": "1" }
		    }
		}
		JSON
	done
}
