# Maintainer: 정한 Rycont <35295182+rycont@users.noreply.github.com>
pkgname=mali-vendor-krane
pkgver=0.1.0
pkgrel=1
pkgdesc="Run ARM's proprietary Mali userspace on mainline MT8183 (Mali-G72)"
url="https://github.com/rycont/mt8183-kukui-pmos/tree/main/gpu"
arch="aarch64"
license="MIT"
# The driver is loaded at startup rather than dlopened, because musl only grants
# initial-exec TLS to libraries present from the beginning; gcompat supplies the
# glibc symbols it asks for, and it wants a libc++ of its own.
# gcompat is not a dependency: it conflicts with glibc-bin over
# so:ld-linux-aarch64.so.1, so its libraries are carried under /opt/gcompat.
depends="libc++ mesa-gbm vulkan-loader"
install="$pkgname.post-install $pkgname.post-deinstall"
source="
	tools/mali-vendor-activate
	system/99-mali-dma-heap.rules
	system/mali-kbase.conf
	system/plasma-mobile-mali.conf
	README.md
	"
builddir="$srcdir"
# The vendor driver must not be stripped; nothing in Alpine provides the glibc
# sonames it asks for (gcompat does, under other names); and it lives in /opt
# because it is not part of the distribution's library set at all.
options="!check !strip !tracedeps !fhs"

# abuild is not consistent about whether a local source keeps its directory,
# so look in both places rather than depend on it.
src() {
	if [ -e "$srcdir/$1" ]; then echo "$srcdir/$1"; else echo "$srcdir/${1##*/}"; fi
}

package() {
	# Assembled by build-packages.sh: the driver taken out of a ChromeOS
	# recovery image, the WSI layer, libc++, and the shims built against both
	# libcs. None of it can be built here -- the driver is not redistributable
	# and the glibc half needs a flatpak runtime.
	[ -d "$startdir/stage/opt/mali" ] || {
		echo "no staged driver; run ./build-packages.sh instead of abuild" >&2
		return 1
	}
	install -d "$pkgdir"
	cp -a "$startdir/stage/opt" "$pkgdir/"

	install -Dm755 "$(src tools/mali-vendor-activate)" \
		"$pkgdir/usr/bin/mali-vendor-activate"
	install -Dm644 "$(src README.md)" \
		"$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 "$(src system/mali-kbase.conf)" \
		"$pkgdir/usr/lib/modules-load.d/mali-kbase.conf"
	install -Dm644 "$(src system/99-mali-dma-heap.rules)" \
		"$pkgdir/usr/lib/udev/rules.d/99-mali-dma-heap.rules"
	install -Dm644 "$(src system/plasma-mobile-mali.conf)" \
		"$pkgdir/usr/lib/systemd/system/plasma-mobile.service.d/20-mali.conf"
}
