diff -ruN a/include/version_compat_defs.h b/include/version_compat_defs.h
--- a/include/version_compat_defs.h	2026-09-05 23:02:09.441000000 +0900
+++ b/include/version_compat_defs.h	2026-09-05 23:05:48.422256199 +0900
@@ -240,4 +240,63 @@
 #define KBASE_CLASS_CREATE(owner, name) class_create(owner, name)
 #endif
 
+
+#if (KERNEL_VERSION(6, 15, 0) <= LINUX_VERSION_CODE)
+/* del_timer()/del_timer_sync() were renamed in 6.15. */
+#define del_timer(t) timer_delete(t)
+#define del_timer_sync(t) timer_delete_sync(t)
+
+/*
+ * hrtimer_init() was replaced by hrtimer_setup(), which also takes the callback;
+ * struct hrtimer::function became __private so it can no longer be assigned
+ * separately. kbase_hrtimer_setup() keeps both spellings working.
+ */
+#define kbase_hrtimer_setup(timer, fn, clock_id, mode) hrtimer_setup((timer), (fn), (clock_id), (mode))
+#define kbase_hrtimer_setup_on_stack(timer, fn, clock_id, mode) \
+	hrtimer_setup_on_stack((timer), (fn), (clock_id), (mode))
+#else
+#define kbase_hrtimer_setup(timer, fn, clock_id, mode)          \
+	do {                                                    \
+		hrtimer_init((timer), (clock_id), (mode));      \
+		(timer)->function = (fn);                       \
+	} while (0)
+#define kbase_hrtimer_setup_on_stack(timer, fn, clock_id, mode)          \
+	do {                                                             \
+		hrtimer_init_on_stack((timer), (clock_id), (mode));      \
+		(timer)->function = (fn);                                \
+	} while (0)
+#endif
+
+
+#if (KERNEL_VERSION(6, 13, 0) <= LINUX_VERSION_CODE)
+/*
+ * Driver page migration moved from tagging individual pages with
+ * __SetPageMovable() to registering movable_operations per page type via
+ * set_movable_ops(). kbase has no page type of its own, and page migration is
+ * optional and disabled by default, so compile the tagging out: the callers sit
+ * inside migration callbacks that are never reached while it is off.
+ */
+#define __SetPageMovable(page, ops)      \
+	do {                             \
+		(void)(page);            \
+		(void)(ops);             \
+	} while (0)
+#define __ClearPageMovable(page) \
+	do {                     \
+		(void)(page);    \
+	} while (0)
+#endif
+
+
+/*
+ * dev_pm_opp_get_voltage_supply() reads one regulator of a multi-supply OPP.
+ * It is a ChromeOS/MediaTek addition to the OPP core and is absent upstream, so
+ * the MediaTek SVS paths that use it cannot be built against a mainline kernel.
+ * Without SVS the driver falls back to the static voltage table, which is the
+ * behaviour on every non-SVS platform.
+ */
+#ifndef KBASE_HAS_OPP_GET_VOLTAGE_SUPPLY
+#define KBASE_HAS_OPP_GET_VOLTAGE_SUPPLY 0
+#endif
+
 #endif /* _VERSION_COMPAT_DEFS_H_ */
