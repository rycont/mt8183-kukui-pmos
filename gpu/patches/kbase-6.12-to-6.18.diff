--- a/Kbuild	2026-09-05 23:02:09.319000000 +0900
+++ b/Kbuild	2026-09-05 23:05:48.420198628 +0900
@@ -20,7 +20,13 @@
 
 # make $(src) as absolute path if it is not already, by prefixing $(srctree)
 # This is to prevent any build issue due to wrong path.
+# Linux 6.13 made $(src) an absolute path to the module source directory for
+# external module builds, so prefixing $(srctree) there yields a bogus path.
+ifneq ($(wildcard $(src)/mali_kbase.h),)
+# $(src) already resolves on its own: leave it alone.
+else
 src:=$(if $(patsubst /%,,$(src)),$(srctree)/$(src),$(src))
+endif
 
 #
 # Prevent misuse when Kernel configurations are not present by default
