diff --git a/render/vulkan/renderer.c b/render/vulkan/renderer.c
index da17a47..c4b44d2 100644
--- a/render/vulkan/renderer.c
+++ b/render/vulkan/renderer.c
@@ -2618,6 +2618,13 @@ struct wlr_renderer *wlr_vk_renderer_create_with_drm_fd(int drm_fd) {
 	// Do not use the drm_fd that was passed in: we should prefer the render
 	// node even if a primary node was provided
 	dev->drm_fd = vulkan_open_phdev_drm_fd(phdev);
+	if (dev->drm_fd < 0 && drm_fd >= 0) {
+		// A device that reaches the GPU outside DRM has no node of its own to
+		// prefer. Without any fd the renderer cannot name a device, and the
+		// compositor then skips linux-dmabuf entirely, leaving clients on shm.
+		// Keep the backend's node so buffer sharing still has a device to name.
+		dev->drm_fd = fcntl(drm_fd, F_DUPFD_CLOEXEC, 0);
+	}
 
 	return vulkan_renderer_create_for_device(dev);
 
