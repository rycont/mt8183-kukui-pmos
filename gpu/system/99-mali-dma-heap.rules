# ARM's Vulkan WSI layer allocates swapchain buffers from the "system" dma-heap,
# and abort()s without a word when it cannot open one. The kernel here is built
# without CONFIG_DMABUF_HEAPS_SYSTEM, so the heap comes from an out-of-tree
# module; see patches/system-heap-as-module.diff.
SUBSYSTEM=="dma_heap", GROUP="video", MODE="0660"
