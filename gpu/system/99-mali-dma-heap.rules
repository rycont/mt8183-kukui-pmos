# ARM's Vulkan WSI layer allocates swapchain buffers from a dma-heap it expects
# to be called "system", and abort()s without a word when the open fails. This
# kernel is built with only the CMA heap, which takes the same ioctls, so give
# it that name. The group has to match whoever runs the compositor.
SUBSYSTEM=="dma_heap", KERNEL=="default_cma_region", SYMLINK+="dma_heap/system", GROUP="video", MODE="0660"
