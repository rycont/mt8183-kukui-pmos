#!/bin/sh
# Assemble ARM's Mali userspace.
#
# The driver is under ARM's EULA and cannot be redistributed, and the only
# Mali-G72 build for Linux is the one ChromeOS ships. So fetch a ChromeOS
# recovery image and take it from there.
#
#   mali-vendor-setup                    download the image for this board
#   mali-vendor-setup --image FILE       use a recovery .zip or .bin already here
#   mali-vendor-setup --root DIR         use a ChromeOS root already mounted
#   mali-vendor-setup --destdir DIR      stage into DIR instead of installing
#
# The image is around 2 GB compressed. It is read as it downloads and only the
# root partition is written out, then removed once the driver has been copied.
#
# --destdir is how build-packages.sh uses this: everything lands under DIR with
# the paths it will have once installed, and the package takes it from there.
# Without it, the files go straight to / and the boot chain is switched over.
set -e

BOARD=kukui
INDEX=https://dl.google.com/dl/edgedl/chromeos/recovery/recovery.json
PREFIX=/opt/mali
GLIBC="$PREFIX/glibc"
WORK="${MALI_WORKDIR:-/var/tmp/mali-vendor-setup}"
SHARE=/usr/share/mali-vendor-krane
[ -d "$SHARE" ] || SHARE="$(dirname "$(readlink -f "$0")")/../system"
KEEP=0
IMAGE=
ROOT=
DESTDIR=

while [ $# -gt 0 ]; do
	case "$1" in
	--image)   IMAGE="$2";   shift 2 ;;
	--root)    ROOT="$2";    shift 2 ;;
	--destdir) DESTDIR="$2"; shift 2 ;;
	--keep)    KEEP=1;       shift ;;
	-h|--help)
		sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
		exit 0 ;;
	*) echo "unknown argument: $1" >&2; exit 2 ;;
	esac
done

if [ "$(id -u)" = 0 ]; then
	SUDO=
else
	[ -n "$DESTDIR" ] || { echo "run as root, or pass --destdir" >&2; exit 1; }
	SUDO=sudo
fi

cleanup() {
	[ -n "$MOUNTED" ] && $SUDO umount "$MOUNTED" 2>/dev/null || true
	[ "$KEEP" = 1 ] || rm -rf "$WORK"
}
trap cleanup EXIT

recovery_url() {
	echo "looking up the latest $BOARD recovery image" >&2
	curl -fsSL --compressed "$INDEX" | python3 -c '
import json, sys
board = sys.argv[1]
images = [e for e in json.load(sys.stdin) if board in e.get("file", "")]
if not images:
    sys.exit(f"no recovery image listed for {board}")
newest = max(images, key=lambda e: [int(n) for n in e["version"].split(".")])
print(newest["url"])
print(newest["version"], file=sys.stderr)
' "$BOARD"
}

# 1. Get at a ChromeOS root filesystem, one way or another.
if [ -z "$ROOT" ]; then
	mkdir -p "$WORK"
	PART="$WORK/root.img"
	if [ -n "$IMAGE" ]; then
		case "$IMAGE" in
		*.zip) bsdtar -xOf "$IMAGE" '*.bin' ;;
		*)     cat "$IMAGE" ;;
		esac | mali-extract-root "$PART"
	else
		URL=$(recovery_url)
		echo "downloading $URL" >&2
		curl -fL --progress-bar "$URL" | bsdtar -xOf - '*.bin' |
			mali-extract-root "$PART"
	fi
	ROOT="$WORK/root"
	mkdir -p "$ROOT"
	$SUDO mount -o ro,loop "$PART" "$ROOT"
	MOUNTED="$ROOT"
fi

BLOB=$(ls "$ROOT"/usr/lib64/libmali.so.* 2>/dev/null | head -1) || true
[ -n "$BLOB" ] || { echo "no libmali under $ROOT/usr/lib64" >&2; exit 1; }
echo "driver: $(basename "$BLOB")"

# 2. Lay it out. musl takes the blob as it is; glibc refuses an object with
#    DT_RELR relocations unless it declares the matching libc version, which
#    the ChromeOS build -- targeting its own loader -- does not.
#
#    The paths inside the manifests are where the files will be at runtime;
#    $DESTDIR only moves where they are written now.
install -d "$DESTDIR$PREFIX/lib" "$DESTDIR$PREFIX/egl" "$DESTDIR$GLIBC/lib" \
	"$DESTDIR$PREFIX/share/vulkan/icd.d" "$DESTDIR$GLIBC/share/vulkan/icd.d"

install -m 0755 "$BLOB" "$DESTDIR$PREFIX/lib/libmali.so"
ln -sf libmali.so "$DESTDIR$PREFIX/lib/libmali.so.0"
mali-declare-dt-relr "$BLOB" "$DESTDIR$GLIBC/lib/libmali.so"
chmod 0755 "$DESTDIR$GLIBC/lib/libmali.so"
ln -sf libmali.so "$DESTDIR$GLIBC/lib/libmali.so.0"
ln -sf "$PREFIX/lib/libmali.so" "$DESTDIR$PREFIX/egl/libGLESv2.so.2"

for P in "$PREFIX" "$GLIBC"; do
	cat > "$DESTDIR$P/share/vulkan/icd.d/mali.json" <<-ICD
	{
	    "file_format_version": "1.0.0",
	    "ICD": {
	        "library_path": "$P/lib/libmali.so",
	        "api_version": "1.3.211"
	    }
	}
	ICD
done

# 3. The WSI layer supplies the VK_KHR_wayland_surface the blob does not have.
#    It is ARM's, but GPU-independent, so a Rockchip build serves.
WSI_URL=https://github.com/ginkage/libmali-rockchip/raw/master/data/vulkan/lib/aarch64/libVkLayer_window_system_integration.so
echo "fetching the WSI layer"
mkdir -p "$WORK"
curl -fsSL "$WSI_URL" -o "$WORK/wsi.so"
for P in "$PREFIX" "$GLIBC"; do
	install -Dm755 "$WORK/wsi.so" \
		"$DESTDIR$P/lib/libVkLayer_window_system_integration.so"
	install -d "$DESTDIR$P/share/vulkan/implicit_layer.d"
	sed "s|@PREFIX@|$P|" "$SHARE/wsi-layer.json.in" \
		> "$DESTDIR$P/share/vulkan/implicit_layer.d/VkLayer_window_system_integration.json"
done

# 4. The blob calls std::__1::__hash_memory, which arrived in LLVM 20. Neither
#    the host nor the freedesktop runtime has a libc++ that new, so carry one
#    next to the driver on the glibc side.
echo "fetching libc++"
POOL=http://ftp.us.debian.org/debian/pool/main/l/llvm-toolchain-21
for pkg in libc++1 libc++abi1; do
	deb=$(curl -fsSL "$POOL/" |
		sed -n "s/.*\"\(${pkg}_[^\"]*_arm64\.deb\)\".*/\1/p" | sort -u | tail -1)
	[ -n "$deb" ] || { echo "no $pkg for arm64 in the Debian pool" >&2; exit 1; }
	curl -fsSL "$POOL/$deb" |
		bsdtar -xOf - 'data.tar.*' |
		bsdtar -xf - -C "$WORK" --strip-components 4 \
			'./usr/lib/aarch64-linux-gnu/*.so.1.0'
done
for lib in libc++ libc++abi; do
	install -Dm755 "$WORK/$lib.so.1.0" "$DESTDIR$GLIBC/lib/$lib.so.1.0"
	ln -sf "$lib.so.1.0" "$DESTDIR$GLIBC/lib/$lib.so.1"
done

# 5. The shim and the layer have to be built against whichever libc loads them.
MALI_DESTDIR="$DESTDIR" mali-build-shims

[ -n "$DESTDIR" ] && exit 0

# 6. Point the boot chain at the DTBs built for kbase, and name Qt's scene
#    graph backend. When mali-vendor-setup is run with --destdir these are the
#    package's job instead -- see mali-vendor-krane.post-install.
mali-vendor-activate
