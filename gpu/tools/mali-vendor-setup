#!/bin/sh
# Put ARM's Mali userspace in place.
#
# The driver is under ARM's EULA and cannot be redistributed, and the only
# Mali-G72 build for Linux is the one ChromeOS ships. So fetch a ChromeOS
# recovery image and take it from there.
#
#   mali-vendor-setup                    download the image for this board
#   mali-vendor-setup --image FILE       use a recovery .zip or .bin already here
#   mali-vendor-setup --root DIR         use a ChromeOS root already mounted
#
# The image is around 2 GB compressed. It is read as it downloads and only the
# root partition is written out, then removed once the driver has been copied.
set -e

BOARD=kukui
INDEX=https://dl.google.com/dl/edgedl/chromeos/recovery/recovery.json
PREFIX=/opt/mali
GLIBC="$PREFIX/glibc"
WORK="${MALI_WORKDIR:-/var/tmp/mali-vendor-setup}"
KEEP=0
IMAGE=
ROOT=

while [ $# -gt 0 ]; do
	case "$1" in
	--image) IMAGE="$2"; shift 2 ;;
	--root)  ROOT="$2";  shift 2 ;;
	--keep)  KEEP=1;     shift ;;
	-h|--help)
		sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
		exit 0 ;;
	*) echo "unknown argument: $1" >&2; exit 2 ;;
	esac
done

[ "$(id -u)" = 0 ] || { echo "run as root" >&2; exit 1; }

cleanup() {
	[ -n "$MOUNTED" ] && umount "$MOUNTED" 2>/dev/null || true
	[ "$KEEP" = 1 ] || rm -rf "$WORK"
}
trap cleanup EXIT

recovery_url() {
	echo "looking up the latest $BOARD recovery image" >&2
	curl -fsSL --compressed "$INDEX" | python3 -c '
import json, sys
board = sys.argv[1]
images = [e for e in json.load(sys.stdin) if board in e.get("file", "")]
if not images:
    sys.exit(f"no recovery image listed for {board}")
newest = max(images, key=lambda e: [int(n) for n in e["version"].split(".")])
print(newest["url"])
print(newest["version"], file=sys.stderr)
' "$BOARD"
}

# 1. Get at a ChromeOS root filesystem, one way or another.
if [ -z "$ROOT" ]; then
	mkdir -p "$WORK"
	PART="$WORK/root.img"
	if [ -n "$IMAGE" ]; then
		case "$IMAGE" in
		*.zip) bsdtar -xOf "$IMAGE" '*.bin' ;;
		*)     cat "$IMAGE" ;;
		esac | mali-extract-root "$PART"
	else
		URL=$(recovery_url)
		echo "downloading $URL" >&2
		curl -fL --progress-bar "$URL" | bsdtar -xOf - '*.bin' |
			mali-extract-root "$PART"
	fi
	ROOT="$WORK/root"
	mkdir -p "$ROOT"
	mount -o ro,loop "$PART" "$ROOT"
	MOUNTED="$ROOT"
fi

BLOB=$(ls "$ROOT"/usr/lib64/libmali.so.* 2>/dev/null | head -1) || true
[ -n "$BLOB" ] || { echo "no libmali under $ROOT/usr/lib64" >&2; exit 1; }
echo "driver: $(basename "$BLOB")"

# 2. Lay it out. musl takes the blob as it is; glibc refuses an object with
#    DT_RELR relocations unless it declares the matching libc version, which
#    the ChromeOS build -- targeting its own loader -- does not.
install -d "$PREFIX/lib" "$PREFIX/egl" "$GLIBC/lib" \
	"$PREFIX/share/vulkan/icd.d" "$GLIBC/share/vulkan/icd.d"

install -m 0755 "$BLOB" "$PREFIX/lib/libmali.so"
ln -sf libmali.so "$PREFIX/lib/libmali.so.0"
mali-declare-dt-relr "$BLOB" "$GLIBC/lib/libmali.so"
chmod 0755 "$GLIBC/lib/libmali.so"
ln -sf libmali.so "$GLIBC/lib/libmali.so.0"
ln -sf "$PREFIX/lib/libmali.so" "$PREFIX/egl/libGLESv2.so.2"

for P in "$PREFIX" "$GLIBC"; do
	cat > "$P/share/vulkan/icd.d/mali.json" <<-ICD
	{
	    "file_format_version": "1.0.0",
	    "ICD": {
	        "library_path": "$P/lib/libmali.so",
	        "api_version": "1.3.211"
	    }
	}
	ICD
done

# 3. The WSI layer supplies the VK_KHR_wayland_surface the blob does not have.
#    It is ARM's, but GPU-independent, so a Rockchip build serves.
WSI_URL=https://github.com/ginkage/libmali-rockchip/raw/master/data/vulkan/lib/aarch64/libVkLayer_window_system_integration.so
echo "fetching the WSI layer"
mkdir -p "$WORK"
curl -fsSL "$WSI_URL" -o "$WORK/wsi.so"
for P in "$PREFIX" "$GLIBC"; do
	install -Dm755 "$WORK/wsi.so" "$P/lib/libVkLayer_window_system_integration.so"
	install -d "$P/share/vulkan/implicit_layer.d"
	sed "s|@PREFIX@|$P|" /usr/share/mali-vendor-krane/wsi-layer.json.in \
		> "$P/share/vulkan/implicit_layer.d/VkLayer_window_system_integration.json"
done

# 4. The blob calls std::__1::__hash_memory, which arrived in LLVM 20. Neither
#    the host nor the freedesktop runtime has a libc++ that new, so carry one
#    next to the driver on the glibc side.
echo "fetching libc++"
POOL=http://ftp.us.debian.org/debian/pool/main/l/llvm-toolchain-21
for pkg in libc++1 libc++abi1; do
	deb=$(curl -fsSL "$POOL/" |
		sed -n "s/.*\"\(${pkg}_[^\"]*_arm64\.deb\)\".*/\1/p" | sort -u | tail -1)
	[ -n "$deb" ] || { echo "no $pkg for arm64 in the Debian pool" >&2; exit 1; }
	curl -fsSL "$POOL/$deb" |
		bsdtar -xOf - 'data.tar.*' |
		bsdtar -xf - -C "$WORK" --strip-components 4 \
			'./usr/lib/aarch64-linux-gnu/*.so.1.0'
done
for lib in libc++ libc++abi; do
	install -Dm755 "$WORK/$lib.so.1.0" "$GLIBC/lib/$lib.so.1.0"
	ln -sf "$lib.so.1.0" "$GLIBC/lib/$lib.so.1"
done

# 5. The shim and the layer have to be built against whichever libc loads them.
mali-build-shims

# 6. Point the boot chain at the DTBs built for kbase. The kernel package
#    installs both sets: the stock ones describe the GPU the way Panfrost wants
#    it, and kbase refuses those.
if [ -d /boot/dtbs/mediatek-mali ]; then
	if ! grep -qs mediatek-mali /etc/deviceinfo; then
		sed -i '/^deviceinfo_dtb=/d' /etc/deviceinfo
		echo 'deviceinfo_dtb="mediatek-mali/mt8183-kukui*"' >> /etc/deviceinfo
	fi
	echo "rebuilding the boot partition for the kbase device tree"
	mkinitfs
else
	echo "warning: /boot/dtbs/mediatek-mali is missing. kbase will not bind to" >&2
	echo "         the stock device tree; install this project's kernel package" >&2
	echo "         (pkgrel 4 or newer) and run this again." >&2
fi

# 7. Name Qt's scene graph backend. plasma-integration probes GL, and when the
#    probe fails it pins the whole session to software rendering -- which draws
#    no glyphs at all in the shell. This is written here rather than shipped in
#    the package because until the driver is in place, asking for Vulkan breaks
#    a working Panfrost session.
if ! grep -qs SceneGraphBackend /etc/xdg/kdeglobals; then
	printf '\n[QtQuickRendererSettings]\nSceneGraphBackend=vulkan\n' \
		>> /etc/xdg/kdeglobals
fi

cat <<-DONE

	Installed. Reboot to use it.

	To go back to Panfrost: drop the deviceinfo_dtb line from /etc/deviceinfo
	and the QtQuickRendererSettings group from /etc/xdg/kdeglobals, then run
	mkinitfs. See /usr/share/doc/mali-vendor-krane/README.md.
DONE
