# Maintainer: 정한 Rycont <35295182+rycont@users.noreply.github.com>
pkgname=plasma-mobile-input-mode-systemd
pkgver=0.3.0
pkgrel=0
pkgdesc="Plasma Mobile quick setting for Plasma Keyboard and IBus Hangul"
url="https://github.com/rycont/mt8183-kukui-pmos/tree/main/plasma-mobile/input-mode"
arch="noarch"
license="MIT"
depends="plasma-mobile ibus ibus-hangul kconfig qt6-qttools systemd flock glib"
checkdepends="python3 qt6-qtdeclarative"
source="
	plasma-input-mode
	plasma-input-mode-auto
	plasma-input-mode-auto.service
	inputmode-main.qml
	metadata.json
	README.md
	LICENSE
	"
builddir="$srcdir"

check() {
	sh -n "$srcdir/plasma-input-mode"
	sh -n "$srcdir/plasma-input-mode-auto"
	python3 -m json.tool "$srcdir/metadata.json" >/dev/null
	/usr/lib/qt6/libexec/qmlcachegen \
		--only-bytecode \
		--warnings-are-errors \
		-I /usr/lib/qt6/qml \
		--resource-path /plasma/quicksettings/org.local.plasma.quicksetting.inputmode/contents/ui/main.qml \
		-o "$builddir/inputmode-main-qmlcache.cpp" \
		"$srcdir/inputmode-main.qml"
}

package() {
	install -Dm755 "$srcdir/plasma-input-mode" \
		"$pkgdir/usr/bin/plasma-input-mode"
	install -Dm755 "$srcdir/plasma-input-mode-auto" \
		"$pkgdir/usr/bin/plasma-input-mode-auto"
	install -Dm644 "$srcdir/plasma-input-mode-auto.service" \
		"$pkgdir/usr/lib/systemd/user/plasma-input-mode-auto.service"
	mkdir -p "$pkgdir/usr/lib/systemd/user/plasma-workspace.target.wants"
	ln -s ../plasma-input-mode-auto.service \
		"$pkgdir/usr/lib/systemd/user/plasma-workspace.target.wants/plasma-input-mode-auto.service"
	install -Dm644 "$srcdir/inputmode-main.qml" \
		"$pkgdir/usr/share/plasma/quicksettings/org.local.plasma.quicksetting.inputmode/contents/ui/main.qml"
	install -Dm644 "$srcdir/metadata.json" \
		"$pkgdir/usr/share/plasma/quicksettings/org.local.plasma.quicksetting.inputmode/metadata.json"
}

